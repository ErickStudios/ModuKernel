{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "ModuCandy",
	"patterns": [
		{
			"include": "#unsafe_asm" 
		},
		{
			"include": "#foocandy_exclusive"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#attrs"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#operations"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#modules"
		},
		{
			"include": "#modern"
		}
	],
	"repository": {
		"unsafe_asm": {
			"begin": "(?<=\\bunsafe\\b )\"",
			"end": "\"",
			"name": "entity",
			"patterns": [
			{
				"include": "source.asm"
			}
			]
		},
		"foocandy_exclusive": {
			"patterns": [
				{ 
					"match": "\\[\\b(Uint32|Int32|Uint16|Int16|Uint8|Int8)\\b\\](([\\w\\.])+|\\[([\\w\\.])+\\])",
					"captures": {
						"1": { "name": "entity.name.class.moducandy "},
						"2": { 
							"patterns": [
								{ "match": "(?<=\\[)\\w+(?=\\])", "name": "entity"},
								{ "match": "\\w+", "name": "variable.moducandy"}
							]
						}
					}
				},
				{
					"name": "keyword",
					"match": "\\b(safe)\\b|(?<=\\bsafe\\b )\\b(increments|decrements|jumps)\\b"
				},
				{
					"match": "(?<=\\bsafe\\b \\bjumps\\b )([\\w:.]+)",
					"captures": {
						"1": {
							"patterns" : [
								{"match": "(\\w+)\\:\\:(?=\\w+)","captures": {"1": {"name": "entity.name.class"} }},
								{"name": "entity.name.function.moducandy" ,"match": "\\w+"}
							]
						}
					}
				}
			]
		},
		"variables": {
			"patterns": [
				{
				"match": "\\b([A-Z]\\w*)\\s+(\\blet\\b)\\s+([\\w:.]+)",
				"captures": {
					"1": { "name": "entity.name.class.moducandy" },   
					"2" : { "name": "keyword.moducandy" },
					"3": { "patterns": [
						{"match": "(\\w+)\\:\\:(?=\\w+)","captures": {"1": {"name": "entity.name.class"} }},
						{"name": "variable.moducandy" ,"match": "\\w+"}
					]}
				}
				}
			]
		},
		"modules": {
			"patterns": [{
				"match": "(\\w+)\\:\\:(?=\\w+)",
				"captures": {
					"1": {"name": "entity.name.class"}
				}
			}]
		},
		"functions": {
			"patterns": [
				{
				"match": "\\b([A-Z]\\w*)\\s+(\\bfn\\b)\\s+([\\w:.]+)\\s*\\(\\)",
				"captures": {
					"1": { "name": "entity.name.class.moducandy" },   
					"2" : { "name": "keyword.moducandy" },
					"3": { "patterns": [
						{"match": "(\\w+)\\:\\:(?=\\w+)","captures": {"1": {"name": "entity.name.class"} }},
						{"name": "entity.name.function.moducandy" ,"match": "\\w+"}
					]}
				}
				},
				{
					"name": "entity.name.function.moducandy",
					"match": "\\w+(?=\\(\\))"
				}
			]
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.moducandy",
				"match": "\\b(unsafe|fn|candy|let|__attr__)\\b"
			},
			{
				"name": "keyword.control.moducandy",
				"match": "\\b(return)\\b"
			}]
		},
		"operations": {
		"patterns": [
			{
				"match": "(\\b(?:r1|r2|r3|r4|r5|r6)\\b)(\\+|\\-|\\*|/|\\?|\\=)(\\b(?:r1|r2|r3|r4|r5|r6)\\b)",
				"captures": {
					"1": { "name": "variable.moducandy" },   
					"2": { "name": "keyword.operator.moducandy" }, 
					"3": { "patterns": [
						{"match": "(\\w+)\\:\\:(?=\\w+)","captures": {"1": {"name": "entity.name.class"} }},
						{"name": "variable.moducandy" ,"match": "\\w+"}
					]}
				}
			},
			{
				"match": "(\\b(?:r1|r2|r3|r4|r5|r6)\\b)(\\=)(\\d+)",
				"captures": {
					"1": { "name": "variable.moducandy" },
					"2": { "name": "keyword.operator.assignment.moducandy" },
					"3": { "name": "constant.numeric.moducandy" }
				}
			}
		]
		},
		"attrs": {
			"begin": "(?<=\\b__attr__\\b )\"",
			"end": "\"",
			"name": "keyword",
			"patterns": [
				{
					"match": "(\\w+)\\=(\\w+)",
					"captures": {
						"1": {"name": "entity.name.class"},
						"2": {"name":"keyword"}
					}
				}
			]
		},
		"comments": {
			"name" : "comment",
			"begin": "//",
			"end": "\n"
		},
		"strings": {
			"name": "string.quoted.double.moducandy",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.moducandy",
					"match": "\\\\."
				}
			]
		},
		"modern": {
			"patterns": [{
				"match": "(\\bstru\\b) ([\\w:.]+)",
				"captures": {
					"1": { "name" : "keyword.moducandy"},
					"2":  { "patterns": [
						{"match": "(\\w+)\\:\\:(?=\\w+)","captures": {"1": {"name": "entity.name.class"} }},
						{"name": "entity.name.type.struct.moducandy" ,"match": "\\w+"}
					]}
				}
			},
			{
				"match": "(\\bpbl\\b) (\\b(candy|fn)\\b)",
				"captures": {
					"1": {"name": "keyword.moducandy"},
					"2": {"name": "keyword.moducandy"}
				}
			}]
		}
	},
	"scopeName": "source.cdy"
}